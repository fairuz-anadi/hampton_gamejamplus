  m_Name: 04_Overboard
  m_EditorClassIdentifier:
  ending: 3
  title: "Man Overboard"
  body: "Three times you said no, and the Captain stopped asking. The ship sailed on without you. Below is every order you were given, and what it cost."
  closingLine: "He never needed you to obey. Only to stay quiet."
