  fadeInEnd: 3.2
  letterboxOutAt: 55.5
  menuAt: 57.5
  lines:
  - start: 2.6
    speaker: THE CAPTAIN
    text: Every great voyage begins with a promise.
    clip: {fileID: 0}
    id: A1
    overSpeaker: 0
  - start: 6.8
    speaker: THE CAPTAIN
    text: 'A promise of discovery. Of glory.

      Of reaching somewhere no one has reached before.'
    clip: {fileID: 0}
    id: A2
    overSpeaker: 0
  - start: 13.6
    speaker: THE CAPTAIN
    text: Welcome aboard. The finest vessel ever built.
    clip: {fileID: 0}
    id: B1
    overSpeaker: 0
  - start: 18.2
    speaker: THE CAPTAIN
    text: A ship that fears neither storm nor sea.
    clip: {fileID: 0}
    id: B2
    overSpeaker: 0
  - start: 26.2
    speaker: THE CAPTAIN
    text: Every hand has a purpose. Every order has a reason.
    clip: {fileID: 0}
    id: C1
    overSpeaker: 0
  - start: 31.6
    speaker: THE CAPTAIN
    text: And every one of you has a part to play.
    clip: {fileID: 0}
    id: C2
    overSpeaker: 0
  - start: 44.4
    speaker: "THE CAPTAIN  \xB7  SHIP'S SPEAKER"
    text: 'One last thing, newcomer.

      When the time comes, I expect you to trust me.'
    clip: {fileID: 0}
    id: D1
    overSpeaker: 1
  - start: 50.4
    speaker: "THE CAPTAIN  \xB7  SHIP'S SPEAKER"
    text: Even when the others don't.
    clip: {fileID: 0}
    id: D2
    overSpeaker: 1
  readingSecondsPerWord: 0.36
