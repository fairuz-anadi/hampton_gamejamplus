--- !u!114 &1786035298
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1786035297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c38f00887202b49449ad3796f8da8db8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningDirector
  path: {fileID: 1786035300}
  cam: {fileID: 1255418759}
  menu: {fileID: 1786035299}
  playScene: Ship
  fadeInEnd: 3.2
  letterboxOutAt: 51.5
  menuAt: 53.5
  lines:
  - start: 2.6
    speaker: THE CAPTAIN
    text: Every great voyage begins with a promise.
    clip: {fileID: 0}
    id: A1
    overSpeaker: 0
  - start: 6.8
    speaker: THE CAPTAIN
    text: 'A promise of discovery. Of glory.

      Of reaching somewhere no one has reached before.'
    clip: {fileID: 0}
    id: A2
    overSpeaker: 0
  - start: 13.6
    speaker: THE CAPTAIN
    text: Welcome aboard. The finest vessel ever built.
    clip: {fileID: 0}
    id: B1
    overSpeaker: 0
  - start: 18.2
    speaker: THE CAPTAIN
    text: A ship that fears neither storm nor sea.
    clip: {fileID: 0}
    id: B2
    overSpeaker: 0
  - start: 26.2
    speaker: THE CAPTAIN
    text: Every hand has a purpose. Every order has a reason.
    clip: {fileID: 0}
    id: C1
    overSpeaker: 0
  - start: 31.6
    speaker: THE CAPTAIN
    text: And every one of you has a part to play.
    clip: {fileID: 0}
    id: C2
    overSpeaker: 0
  - start: 44.4
    speaker: "THE CAPTAIN  \xB7  SHIP'S SPEAKER"
    text: 'One last thing, newcomer.

      When the time comes, I expect you to trust me.'
    clip: {fileID: 0}
    id: D1
    overSpeaker: 1
  - start: 50.4
    speaker: "THE CAPTAIN  \xB7  SHIP'S SPEAKER"
    text: Even when the others don't.
    clip: {fileID: 0}
    id: D2
    overSpeaker: 1
  readingSecondsPerWord: 0.36
